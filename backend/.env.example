# ======================================================================
# DeepSearch AI API - environment file. Never commit this file.
# ======================================================================

# ---- Security ----------------------------------------------------------
# Signs login tokens. Keep it secret; changing it logs everyone out.
JWT_SECRET=replace-with-a-long-random-string

# Required: Firebase Firestore is the only persistent database.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Use the one-line JSON contents in Vercel; use a file path for local development.
FIREBASE_CREDENTIALS=secrets/firebase-service-account.json

# ---- Web search (at least one) ----------------------------------------
# auto = Brave first, else Serper. Or force: brave / serper
SEARCH_PROVIDER=serper
BRAVE_API_KEY=
SERPER_API_KEY=
BRAVE_COST_PER_REQUEST=0.005
SERPER_COST_PER_REQUEST=0.001

# ---- AI summary (Gemini) ----------------------------------------------
ENABLE_AI_SUMMARY=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Limits -----------------------------------------------------------
DAILY_SEARCH_LIMIT=40
DAILY_SUMMARY_LIMIT=40
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT=8
# Most profiles one search returns.
RESULTS_LIMIT=80
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
ENABLE_RESULT_IMAGES=true

# Web addresses allowed to call the API from a browser (leave blank for an iOS/Android-only app), comma separated.
# Example: CORS_ORIGINS=http://localhost:8081,https://app.example.com
CORS_ORIGINS=

# Set true only on your own computer to enable /docs
DEBUG=false
# Depth per platform. Another page is fetched only while the last one still held real name matches, so common
# names go deep and unusual names stop early. One page = one Serper request (about 25-55 requests per search).
# Lower these (e.g. SEARCH_PAGES=2, IMAGE_PAGES=1, IMAGE_LOOKUPS=5) to spend fewer credits.
SEARCH_PAGES=3
IMAGE_PAGES=2
IMAGE_LOOKUPS=10
SEARCH_CONCURRENCY=16
# Profile pictures from Google Images (one query per platform, matched to each profile's own page).
ENABLE_PLATFORM_IMAGES=true

# ---- Password reset email (Resend, https://resend.com) ------------------
# Create an API key there and verify the sending domain (wellminddatasolutions.com) first.
# Without a key the "Forgot password?" request answers "not available" instead of failing silently.
RESEND_API_KEY=
EMAIL_FROM=DeepSearch AI <info@wellminddatasolutions.com>
RESET_CODE_MINUTES=15
