# Address of the DeepSearch AI server. Must be https:// for a real release.
# Simulator on the same Mac: http://localhost:8000
# Real iPhone on the same Wi-Fi: http://192.168.1.20:8000 (your Mac's address)
# Android emulator: http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup/config
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id
# Native iOS/Android only: add platform OAuth client IDs if testing with Expo AuthSession.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
